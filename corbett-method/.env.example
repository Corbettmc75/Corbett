# Copy to your process manager / secret manager. Never commit real values.
PORT=8787
HOST=127.0.0.1
# Where the SQLite database, uploaded drawings and page previews are stored
DATA_DIR=./var
# Set to 1 when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=0
# Server-side only. Leave blank to use the text-layer fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
